# https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Model calls run through the Claude Code CLI (must be installed: npm i -g @anthropic-ai/claude-code).
# Recommended: a subscription setup token from `claude setup-token` — billed to your Claude plan, not per-call.
ANTHROPIC_AUTH_TOKEN=sk-ant-oat01-...
# Fallback: metered Anthropic API key (https://console.anthropic.com). Ignored when AUTH_TOKEN is set.
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: only for sites that sit behind a site-password gate or a login.
# SITE_PASSWORD=...
# AUTH_EMAIL=...
# AUTH_PASSWORD=...
